<?xml version="1.0" encoding="utf-8"?>
<!-- The only NuGet configuration the publish scripts use (scripts/dotnet-build-env.mjs passes it as the config file of the restore, so no machine / user / repo-ancestor
     NuGet.Config is read). One source, the official feed over HTTPS; every package may come only from it. Deliberately NOT named nuget.config: arch rule 11e
     refuses a file of that name in the approver's directory chain, and this one is never picked up by itself. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
