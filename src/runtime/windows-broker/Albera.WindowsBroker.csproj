<Project Sdk="Microsoft.NET.Sdk">
  <!-- Host Broker prototype (ADR-002, Proposed / NOT VERIFIED). Built only on demand by
       `npm run build:windows-broker` or the Broker tests. Nothing installs, registers or starts it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>albera-windows-broker</AssemblyName>
    <RootNamespace>Albera.WindowsBroker</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AlberaBrokerTestFaults)' == 'true'">
    <!-- Test-only failure injection (serve-fault subcommand). Only the fault-injection tests pass this property;
         the shipped build never does, so the seam does not exist in the production binary. -->
    <DefineConstants>$(DefineConstants);ALBERA_BROKER_TEST_FAULTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>
</Project>
