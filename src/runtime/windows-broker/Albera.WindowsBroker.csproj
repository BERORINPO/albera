<Project Sdk="Microsoft.NET.Sdk">
  <!-- Host Broker prototype (ADR-002, Proposed / NOT VERIFIED). Built only on demand by
       `npm run build:windows-broker` or the Broker tests. Nothing installs, registers or starts it. The `service` entry (ServiceHost.cs)
       only answers the service control manager when something else has already registered the program; it adds no package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>albera-windows-broker</AssemblyName>
    <RootNamespace>Albera.WindowsBroker</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AlberaBrokerTestFaults)' == 'true'">
    <!-- Test-only failure injection (serve-fault subcommand). Only the fault-injection tests pass this property;
         the shipped build never does, so the seam does not exist in the production binary. -->
    <DefineConstants>$(DefineConstants);ALBERA_BROKER_TEST_FAULTS</DefineConstants>
  </PropertyGroup>
  <!-- The symbol can also arrive from outside (an environment variable named DefineConstants, a Directory.Build.props, -p:DefineConstants=...). Pinning the switch
       false does not stop that, so a build without the switch that still carries the symbol fails instead of shipping the seam (which includes the stand-in for the service SID). -->
  <Target Name="RefuseInheritedTestSymbol" BeforeTargets="BeforeCompile;CoreCompile" Condition="'$(AlberaBrokerTestFaults)' != 'true' and $(DefineConstants.Contains('ALBERA_BROKER_TEST_FAULTS'))">
    <Error Code="ALBERA_SEAM" Text="ALBERA_BROKER_TEST_FAULTS is defined but AlberaBrokerTestFaults is not true: refusing to build the test seam into a non-test build." />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- The receipt v2 contract (ADR-002 "Receipt v2"): the C# twin is source-included, never copied, so the Broker and the Approval Authority validate with the same code. -->
    <Compile Include="../broker-contract/*.cs" Link="BrokerContract/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
