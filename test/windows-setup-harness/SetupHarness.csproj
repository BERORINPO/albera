<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test-only console: compiles the setup sources (everything except Program.cs) by source include as ordinary .NET (the NativeAOT bytes can only be made in CI) and runs the
       unit checks in-process. gh.exe and the installer script are replaced by a fake process runner; the only real child processes are cmd.exe and ping.exe in the environment
       and timeout checks. Built in a temp dir by test/runtime-windows-setup-unit.test.mjs; nothing ships it. Pass -p:SetupDir=<abs path ending in a slash>. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Albera.Setup</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseAppHost>false</UseAppHost>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SetupDir)*.cs" Exclude="$(SetupDir)Program.cs" />
  </ItemGroup>
</Project>
