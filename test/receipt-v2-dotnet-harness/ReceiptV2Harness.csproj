<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test-only console: compiles the broker-contract C# sources exactly as a future .NET project would include them
       (source include, BCL only) and prints the verdict for every shared test vector. Built in a temp dir by
       test/runtime-broker-contract-dotnet.test.mjs; nothing ships it. Pass -p:ContractDir=<abs path ending in a slash>. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseAppHost>false</UseAppHost>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ContractDir)*.cs" />
  </ItemGroup>
</Project>
