<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test-only console: compiles the WSL bridge sources (everything except Program.cs / TestSeam.cs) and the broker-contract sources by source include, with fake hosts, and runs the checks in-process.
       Built in a temp dir by test/runtime-wsl-bridge.test.mjs; nothing ships it. Pass -p:BridgeDir=<abs path ending in a slash> and -p:ContractDir=<abs path ending in a slash>. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Albera.WslBridge.Harness</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseAppHost>false</UseAppHost>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(BridgeDir)*.cs" Exclude="$(BridgeDir)Program.cs;$(BridgeDir)TestSeam.cs" />
    <Compile Include="$(ContractDir)*.cs" />
  </ItemGroup>
</Project>
