<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test-only console: compiles src/runtime/windows-approver/MatchCode.cs by itself (it has no other dependency, BCL only) and prints the C# result for every
       vector of match-code-vectors.json. Built in a temp dir by test/runtime-match-code-dotnet.test.mjs; nothing ships it. Pass -p:MatchCodeSource=<abs path of MatchCode.cs>. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseAppHost>false</UseAppHost>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MatchCodeSource)" />
  </ItemGroup>
</Project>
