{
  "name": "albera",
  "version": "0.2.0",
  "description": "Anni Albers-inspired read-only local dashboard for Claude Code sessions, part of the ALBERA development platform.",
  "type": "module",
  "bin": {
    "albera": "src/entry/server.mjs"
  },
  "files": [
    "src/entry",
    "src/core",
    "src/adapters",
    "src/shared",
    "public",
    "README.md",
    "README.ja.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BERORINPO/pigeonholes.git"
  },
  "homepage": "https://github.com/BERORINPO/pigeonholes#readme",
  "bugs": {
    "url": "https://github.com/BERORINPO/pigeonholes/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "sessions",
    "dashboard",
    "local",
    "read-only",
    "cli"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/entry/server.mjs",
    "demo": "node src/entry/server.mjs --demo",
    "test": "node --test",
    "arch": "node scripts/arch-check.mjs",
    "build:windows-job-guardian": "node scripts/publish-windows-job-guardian.mjs",
    "build:windows-broker": "node scripts/publish-windows-broker.mjs",
    "build:approval-authority": "node scripts/publish-windows-approval-authority.mjs",
    "build:approver": "node scripts/publish-windows-approver.mjs",
    "package:approver-msix": "node scripts/package-windows-approver-msix.mjs",
    "build:windows-service-lab": "node scripts/publish-windows-service-lab.mjs",
    "check:reproducible": "node scripts/check-reproducible-build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "bench:runtime-store": "node scripts/runtime-sqlite-benchmark.mjs",
    "package:smoke": "node scripts/package-smoke.mjs"
  }
}
